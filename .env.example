# Application
SPRING_APPLICATION_NAME=internship-manager

# Database
DB_HOST=localhost
DB_PORT=3306
DB_NAME=internship_management_db
DB_USER=internship_user
DB_PASS=your_secure_password

# JWT
JWT_SECRET=replace_with_a_secure_64_character_secret

# Mail / SMTP
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your_email@example.com
MAIL_PASSWORD=your_mail_password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS_ENABLE=true
MAIL_STARTTLS_REQUIRED=true
MAIL_FROM=your_email@example.com

# Application mail and reminder settings
REMINDER_ENABLED=true
REMINDER_WINDOW_HOURS=24
REMINDER_CRON=0 0 * * * *

# OpenAI integration (optional)
OPENAI_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini
OPENAI_CHATBOT_SYSTEM_PROMPT=Tu es l assistant officiel IIT StageManager. Tu aides les etudiants, enseignants et administrateurs a utiliser la plateforme, tu reponds de maniere claire et concise, et tu ne proposes jamais de creation ou modification automatique sans demander explicitement une confirmation.

# Storage
STORAGE_PROVIDER=local
STORAGE_LOCAL_UPLOAD_DIR=uploads/internship-documents
